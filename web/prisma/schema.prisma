generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passcodeHash String
  role         Role     @default(MENTEE)
  preferences  Json     @default("{}")
  onboarded    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings  Booking[] @relation("MenteeBookings")
  reports   Report[]
  auditLogs AuditLog[]

  @@index([email])
}

enum Role {
  MENTEE
  MENTOR
  ADMIN
}

model Mentor {
  id            String   @id @default(cuid())
  userId        String   @unique
  name          String
  headline      String
  initials      String
  bio           String
  domains       String[]
  tags          String[]
  stages        String[]
  locations     String[]
  languages     String[]
  meetings      String[]
  pricing       String
  trustScore    Int
  reviewQuality Int
  responseRate  Int
  verified      String[]
  payment       String
  meeting       String
  availability  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings Booking[] @relation("MentorBookings")

  @@index([domains])
}

model Booking {
  id                   String       @id @default(cuid())
  menteeId            String
  mentorId            String
  problemSummary      String
  payment             String
  meetingInstructions String
  state               BookingState @default(REQUESTED)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  mentee User   @relation("MenteeBookings", fields: [menteeId], references: [id], onDelete: Cascade)
  mentor Mentor @relation("MentorBookings", fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([menteeId])
  @@index([mentorId])
  @@index([state])
}

enum BookingState {
  REQUESTED
  CLARIFICATION_REQUESTED
  ACCEPTED
  PAYMENT_PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  REJECTED
}

model Report {
  id             String     @id @default(cuid())
  reporterId     String
  targetMentorId String?
  category       String
  risk           RiskLevel  @default(LOW)
  description    String
  status         ReportStatus @default(OPEN)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([risk])
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ReportStatus {
  OPEN
  RESOLVED
  SUSPENDED
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  message   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}
