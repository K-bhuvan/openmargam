# Database (Postgres)
# Local dev: postgres://postgres:postgres@localhost:5432/openmargam
# Production (Neon): postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/openmargam?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/openmargam?schema=public"

# Auth
JWT_SECRET="change-me-in-production-min-32-chars-string"
SESSION_COOKIE_NAME="openmargam_session"

# App
NEXT_PUBLIC_APP_NAME="OpenMargam"

# Connection pool (production)
# Neon free tier: 100 max connections; we use 10 per serverless instance
DATABASE_CONNECTION_LIMIT="10"
